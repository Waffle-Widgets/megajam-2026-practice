# Unreal Engine generated folders
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
Platforms/
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Packaged builds (upload these to itch.io, don't commit them)
Packaged/
Builds/
*.zip

# IDE / build files
.vs/
.vscode/
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Raw source files for imported assets (the .uasset holds the data; keep the source next to it
# so Unreal does not ask to delete the asset, but do not commit it)
MegaJamPractice/Content/Game/Imported/**/*.png
MegaJamPractice/Content/Game/Imported/**/*.jpg
MegaJamPractice/Content/Game/Imported/**/*.fbx
MegaJamPractice/Content/Game/Imported/**/*.Fbx

# Per-PC Claude Code settings
.claude/settings.local.json

# Blender auto-backups
*.blend1
# Baked textures and FBX exports from the Blender scripts (rebuilt by running the script)
Art/Blender/textures/
Art/Blender/export/*
# ...except the kits the Unreal PC imports (this PC builds them, GameStation imports them)
!Art/Blender/export/World/
!Art/Blender/export/City/
# Personal reference photos (may show number plates)
Art/Reference/

# baked maps and lamp points from the TRELLIS pipeline
Art/Blender/cache/

# local image generator output (tools/gen_images.py)
Art/Refs/gen/
